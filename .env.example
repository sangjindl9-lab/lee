# ── 기본 ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
DATA_DIR=./data                 # DB·암호화 파일 저장 위치(운영: 영구 디스크)
TRUST_PROXY=0                   # 프록시 뒤(Render 등)에서는 1
COOKIE_SECURE=0                 # HTTPS 운영에서는 1

# ── 비밀값(운영에서는 반드시 직접 생성: openssl rand -hex 32) ──
SESSION_SECRET=
FILE_MASTER_KEY=                # 64자리 hex. 분실 시 납품 파일 복호화 불가 → 별도 백업
FILE_MASTER_KEY_ID=k1

# ── 최초 최고관리자(없을 때만 생성) ───────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
REQUIRE_ADMIN_MFA=1             # 운영자 화면 접근 시 TOTP 필수(개발 편의로 0 가능)

# ── 결제 사업자 ──────────────────────────────────────
# sandbox : 내장 테스트 결제(실제 돈 이동 없음, 대금 보호 없음)
# toss    : 토스페이먼츠 결제 승인·조회·취소 어댑터(실계정 검증 전, docs/05 참고)
PAYMENT_PROVIDER=sandbox
SANDBOX_WEBHOOK_SECRET=
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ── 파일 검사 ────────────────────────────────────────
CLAMSCAN_PATH=                  # 예: /usr/bin/clamscan. 비우면 악성 파일 검사는 "검사 불가"로 표시
MAX_UPLOAD_MB=200

# ── 선택: AI 초안 기능(없어도 거래 기능은 모두 동작) ──
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
